# Copy to .env. Never commit the copy. No value in this file is a secret.

# The port `npm start` listens on. `npm run dev` reads PORT from the shell only, as in
# `PORT=3100 npm run dev`, or `$env:PORT=3100; npm.cmd run dev` in Windows PowerShell.
# Both bind 127.0.0.1 only.
PORT=3000

# SQLite database file. Created, migrated and seeded on first run.
DATABASE_PATH=./data/overheard.db

# Provider keys. Read server side only, never sent to the browser or logged.
# Read again while the app runs, so a key added here needs no restart. A key
# set in your shell wins over this file.
# A provider with no key here is shown as not configured and is never called.
# Paste as plain text. A key that picked up an invisible character on the way,
# which a copy from a web page or a PDF can, cannot be sent as an HTTP header:
# that provider is reported as not configured and the value is never sent.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Accepted alias for GOOGLE_API_KEY, because that is the name Google's own
# examples use. GOOGLE_API_KEY wins when both are set.
GEMINI_API_KEY=

# Subscription mode (beta). A provider with no key above is asked through its
# command line tool instead, when that tool is installed and signed in with
# your Claude or ChatGPT plan: Claude Code for Anthropic, Codex for OpenAI.
# Calls then count against your plan, not a bill. A key, when set, wins. Sign
# in once with `claude auth login` or `codex login`. A command that is not
# installed is ignored. Put its full path here if the app runs where it is not
# on your PATH, or empty the line to turn the mode off. The README's
# subscription mode section says what changes.
OVERHEARD_ANTHROPIC_CLI=claude
OVERHEARD_OPENAI_CLI=codex

# Per-provider ceiling on simultaneous in-flight calls. Defaults: OpenAI 6,
# Anthropic 6, Google 3, and 3 for a provider in subscription mode. Lower one if
# your key's tier returns 429s; raise one only if you know your tier handles it.
# Account settings has a field for each; a value set here wins over that field,
# which then shows read-only. An invalid value falls back to the Account
# settings value, or to the default.
OVERHEARD_MAX_INFLIGHT_OPENAI=
OVERHEARD_MAX_INFLIGHT_ANTHROPIC=
OVERHEARD_MAX_INFLIGHT_GOOGLE=

# Test seam. Set to 1 and every provider returns a canned answer: no network,
# no key, no spend. For demos and tests only. The app says so on screen.
OVERHEARD_MOCK_PROVIDERS=
